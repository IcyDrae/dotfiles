[global]
    width = 380
    height = (0, 250)
    origin = top-right
    offset = (16, 16)

    font = Iosevka 14
    format = "<b>%s</b>\n%b"

    frame_width = 2
    frame_color = "#89b4fa"
    corner_radius = 12
    gap_size = 8

    padding = 12
    horizontal_padding = 14
    line_height = 4

    icon_position = left
    max_icon_size = 48

    separator_height = 1
    transparency = 0

[urgency_low]
    background = "#1e1e2e"
    foreground = "#a6adc8"
    timeout = 4

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 6

[urgency_critical]
    background = "#313244"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0

